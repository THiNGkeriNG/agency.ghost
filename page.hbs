{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#post}}

{{!-- Homepage / students-page section sources are edited as pages but shouldn't stand alone --}}
{{#has slug="home-services, home-platforms, home-partners, home-clients, home-how, home-faq"}}
<meta name="robots" content="noindex"><meta http-equiv="refresh" content="0; url={{@site.url}}/">
{{/has}}
{{#has slug="students-what-you-get, students-ways-in, students-how, students-alumni, students-faq"}}
<meta name="robots" content="noindex"><meta http-equiv="refresh" content="0; url={{@site.url}}/students/">
{{/has}}

<main class="gh-main">
    <article class="gh-article {{post_class}}">

        {{#match @page.show_title_and_feature_image}}
            <header class="gh-article-header gh-canvas">
                <h1 class="gh-article-title is-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
                {{/if}}
                {{> "feature-image"}}
            </header>
        {{/match}}

        <section class="gh-content gh-canvas is-body">
            {{content}}
        </section>

    </article>
</main>

{{/post}}