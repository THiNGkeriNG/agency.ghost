{
    "name": "agency-cu",
    "description": "Student Agency at CU Denver \u2014 design 2, modeled on cudenver.edu",
    "version": "0.2.0",
    "engines": {
        "ghost": ">=5.0.0",
        "node": ">=22.12.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "build": "gulp build",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "pnpm zip",
        "pretest:ci": "pnpm zip",
        "preship": "pnpm test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then git push --follow-tags; else echo \"Uncommitted changes found.\" && exit 1; fi",
        "postship": "git fetch && gulp release"
    },
    "packageManager": "pnpm@12.16.0",
    "author": {
        "name": "Brad Hinson"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/THiNGkeriNG/agency.ghost.git"
    },
    "contributors": "https://github.com/TryGhost/Source/graphs/contributors",
    "devDependencies": {
        "@tryghost/release-utils": "0.9.4",
        "@tryghost/theme-translations": "0.0.22",
        "autoprefixer": "10.6.2",
        "beeper": "2.1.0",
        "cssnano": "9.9.0",
        "gscan": "6.6.1",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "inquirer": "14.2.5",
        "postcss": "8.5.32",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.4"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xs": {
                "width": 160
            },
            "s": {
                "width": 320
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "navigation_layout": {
                "type": "select",
                "options": [
                    "Logo in the middle",
                    "Logo on the left",
                    "Stacked"
                ],
                "default": "Logo in the middle"
            },
            "site_background_color": {
                "type": "color",
                "default": "#ffffff"
            },
            "header_and_footer_color": {
                "type": "select",
                "options": [
                    "Background color",
                    "Accent color"
                ],
                "default": "Background color"
            },
            "title_font": {
                "type": "select",
                "options": [
                    "Modern sans-serif",
                    "Elegant serif",
                    "Consistent mono"
                ],
                "default": "Modern sans-serif"
            },
            "body_font": {
                "type": "select",
                "options": [
                    "Modern sans-serif",
                    "Elegant serif"
                ],
                "default": "Modern sans-serif"
            },
            "signup_heading": {
                "type": "text",
                "description": "Used in your footer across your theme, defaults to site title when empty"
            },
            "signup_subheading": {
                "type": "text",
                "description": "Defaults to site description when empty"
            },
            "show_post_metadata": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "enable_drop_caps_on_posts": {
                "type": "boolean",
                "default": false,
                "group": "post"
            },
            "show_related_articles": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "compact_logo": {
                "type": "image",
                "description": "One-line logo the header switches to after you scroll. Leave empty to just shrink the main logo."
            },
            "director_photo": {
                "type": "image",
                "description": "Brad's photo for the 'Your first hour' section."
            },
            "booking_link": {
                "type": "text",
                "default": "",
                "description": "Scheduling link for the free first hour (Calendly, Microsoft Bookings\u2026). Leave empty to use email."
            },
            "show_preview_notes": {
                "type": "boolean",
                "default": true,
                "description": "Show the red dashed 'Preview' markers on unfinished content. Turn off before launch."
            },
            "hero_headline": {
                "type": "text",
                "default": "Kind, Affordable Help Going Digital.",
                "group": "homepage"
            },
            "hero_intro": {
                "type": "text",
                "default": "Graduate students from CU Denver's School of Education help you build your course, training, or media, and show you how to keep it going.",
                "group": "homepage"
            },
            "students_headline": {
                "type": "text",
                "default": "Practice the Profession Before You Graduate.",
                "description": "Students page headline."
            },
            "students_intro": {
                "type": "text",
                "default": "Agency projects put you on real learning design work for real clients, with the software and the people of the field. Credit now, a community for good.",
                "description": "Students page intro."
            }
        }
    }
}
